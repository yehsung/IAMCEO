{
  "sourceLanguage" : "ko",
  "strings" : {
    "앱의 메뉴와 안내 글에 쓰는 언어로, 이 기기에만 저장됩니다. 총괄·팀장이 쓰는 보고의 언어는 '보고 언어'에서 따로 정합니다." : {
      "comment" : "W(0.2.5) 앱 화면 언어(설정 → 일반 → 이 기기)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The language of the app's menus and messages, saved on this device only. The language your lead and staff write reports in is set separately under Report language."
          }
        }
      }
    },
    "언어" : {
      "comment" : "W(0.2.5) 앱 화면 언어(설정 → 일반 → 이 기기)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Language"
          }
        }
      }
    },
    "자동" : {
      "comment" : "W(0.2.5) 앱 화면 언어(설정 → 일반 → 이 기기)",

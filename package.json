{
  "name": "iamceo",
  "version": "0.2.2",
  "private": true,
  "description": "AI 팀을 운영하는 사람의 창구 — CLI AI 세션을 홈·결재함·팀·대화·자료로 지휘한다",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/yehsung/IAMCEO.git"
  },
  "os": [
    "darwin"
  ],
  "type": "module",
  "bin": {
    "iamceo": "bin/iamceo.ts"
  },
  "scripts": {
    "start": "bun bin/iamceo.ts serve",
    "dev": "bun --watch bin/iamceo.ts serve",
    "test": "bash scripts/check.sh server",
    "check": "bash scripts/check.sh all",
    "check:ts": "bash scripts/check.sh ts",
    "test:server": "bash scripts/check.sh server",
    "test:native": "bash scripts/check.sh swift",
    "test:perf": "IAMCEO_PERF_STRICT=1 bash scripts/check.sh server tests/file-search.test.ts tests/stall-fix.test.ts",
    "smoke:db": "bun scripts/smoke-db.ts",
    "build:check": "bash scripts/check.sh build",
    "release:mac": "bun scripts/release-mac.ts",
    "typecheck": "tsc --noEmit",
    "build": "bun build bin/iamceo.ts --compile --outfile dist/iamceo",
    "build:release": "bun scripts/build-release.ts",
    "setup:core": "bun scripts/setup-core.ts",
    "native:build": "swift build --package-path native",
    "native:test": "swift test --package-path native",
    "build:native": "bun scripts/build-native.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}

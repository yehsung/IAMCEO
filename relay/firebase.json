{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" ci --no-audit --no-fund",
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ],
    "ignore": [
      "node_modules",
      "src",
      "test",
      "scripts",
      "tsconfig.json",
      "tsconfig.test.json",
      "bun.lock",
      ".env.example",
      "*.local",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  }
}

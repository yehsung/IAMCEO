{
  "name": "iamceo-relay",
  "version": "1.0.0",
  "private": true,
  "description": "IAMCEO iPhone notification relay (Cloud Functions for Firebase, 2nd gen). Builds a fixed-text APNs payload and sends it with the IAMCEO topic key; stores nothing.",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "gcp-build": "",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@firebase/database-compat": "2.1.7"
  }
}

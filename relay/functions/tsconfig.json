{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2023"],
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["src"]
}
